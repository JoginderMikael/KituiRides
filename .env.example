# Copy this file to `.env` at the repo root before running `docker compose up`.
# Keep real credentials out of git.

POSTGRES_DB=kituirides
POSTGRES_USER=kituirides
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
DB_URL=jdbc:postgresql://postgres:5432/kituirides
DB_USERNAME=kituirides
DB_PASSWORD=replace-with-a-local-postgres-password

APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_JWT_EXPIRATION_MS=86400000

APP_SUPERADMIN_EMAIL=
APP_SUPERADMIN_PASSWORD=
APP_SUPERADMIN_FIRST_NAME=Super
APP_SUPERADMIN_LAST_NAME=Admin
APP_SUPERADMIN_PHONE=

APP_KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

APP_MPESA_BASE_URL=https://sandbox.safaricom.co.ke
APP_MPESA_SHORTCODE=replace-with-your-daraja-shortcode
APP_MPESA_PASSKEY=replace-with-your-daraja-passkey
APP_MPESA_CALLBACK_URL=https://your-public-domain/api/payments/mpesa/callback
APP_MPESA_CONSUMER_KEY=replace-with-your-daraja-consumer-key
APP_MPESA_CONSUMER_SECRET=replace-with-your-daraja-consumer-secret
APP_MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
APP_MPESA_SIMULATED=true

VITE_GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-api-key
